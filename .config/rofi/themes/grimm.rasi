* {
  margin : 0;
  padding : 0;
  spacing : 0;

  bg0 : #1a1a1a;
  bg1 : #222222;
  bg2 : #2d2d2d;
  bg3 : #3a3a3a;

  fg0 : #e0e0e0;
  fg1 : #c0c0c0;
  fg2 : #909090;

  font : "JetBrainsMono Nerd Font Propo ExtraBold 14";
}

window {
  width : 25%;
  background-color : @bg0;
  // location : center;
  // orientation : horizontal;
  children : [inputbar, message, listview];
}

inputbar {
  background-color : @bg0;
  children : [prompt, entry];
}

prompt {
  margin : 6px 0 6px 6px;
  padding : 3px 6px;
  text-color : @fg0;
  background-color : @bg2;
}

entry {
  margin : 6px;
  padding : 3px 6px;
  text-color : @fg0;
  background-color : @bg1;
}

listview {
  lines : 8;
  children : [element];
  margin : 0 6px 6px 6px;
  padding : 6px;
  background-color : @bg0;
}

element {
  margin : 0 0 4px 0;
  background-color : @bg1;
}

element selected {
  background-color : @bg3;
}

element selected active {
  background-color : @bg3;
}

element-text {
  padding : 6px;
  text-color : @fg0;
  background-color : transparent;
}

element-text selected {
  text-color : @fg0;
  background-color : transparent;
}

element-text selected active {
  text-color : @fg0;
  background-color : transparent;
}

element-icon {
  size : 20px;
  padding : 6px;
  background-color : transparent;
}

element-icon selected {
  background-color : transparent;
}

element-icon selected active {
  background-color : transparent;
}

message {
  margin : 0;
  expand : true;
  background-color : @bg0;
  children : [textbox];
}

textbox {
  expand : true;
  padding : 6px;
  background-color : @bg0;
  text-color : @fg2;
}

error-message {
  expand : true;
  text-color : @fg0;
  background-color : @bg3;
}
