{
  "output": ["HDMI-A-1"],
  "position": "bottom",
  "height": 30,
  "spacing": 5,

  "modules-left": ["group/workspaces", "group/music"],

  "modules-center": ["group/windows"],

  "modules-right": [
    "group/internet_speed",
    "temperature",
    // "group/gpus",
    "group/cpuram",
    "group/sound",
    "group/system",
    "group/tray-box",
  ],
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input", "/sys/class/thermal/thermal_zone0/temp"],
    // "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C ",
    "format": "{temperatureC}°C ",
  },

  "custom/openbracket": {
    "format": "[",
    "tooltip": false,
  },

  "custom/closebracket": {
    "format": "]",
    "tooltip": false,
  },

  "custom/split": {
    "format": "|",
    "tooltip": false,
  },

  "group/music": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "mpris", "custom/closebracket"],
  },

  "custom/net_speed": {
    "exec": "~/.config/waybar/scripts/net_speed.sh",
    "interval": 1,
    "format": "{text}",
    "tooltip": false,
  },

  "group/internet_speed": {
    "orientation": "horizontal",
    "modules": [
      "custom/openbracket",
      "custom/net_speed",
      "custom/closebracket",
    ],
  },

  "custom/gpu-usage": {
    "exec": "~/.config/waybar/scripts/gpu_usage.sh",
    "return-type": "json",
    "interval": 2,
  },

  "group/gpus": {
    "orientation": "horizontal",
    "modules": [
      "custom/openbracket",
      "custom/gpu-usage",
      "custom/closebracket",
    ],
  },

  "wireplumber": {
    "format": "vol {volume}% ",
    "format-muted": "muted {volume}%",
    // "format-icons": {
    //   "headphone": "󰋋",
    //   "hands-free": "󱡏",
    //   "headset": "󰋎",
    //   "phone": "󰏲",
    //   "portable": "󰦢",
    //   "car": "󰄋",
    //   "default": ["󰕿", "󰖀", "󰕾"],
    // },
    "on-click": "helvum",
    "tooltip-format": "Volume: {volume}%",
  },

  "group/sound": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "wireplumber", "custom/closebracket"],
  },

  "group/utilities": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "custom/artix", "custom/closebracket"],
  },

  "custom/artix": {
    "format": "\uf31f",
    "tooltip": false,
    "on-click": "rofi -show drun -no-show-icons",
  },

  "group/workspaces": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "ext/workspaces", "custom/closebracket"],
  },

  "niri/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
  },

  "mpris": {
    "format": "  {status_icon} | {dynamic}",
    "interval": 1,
    "dynamic-len": 40,
    "status-icons": {
      "playing": "▶",
      "paused": "⏸",
      "stopped": "",
    },
    "dynamic-order": ["artist"],
  },

  "group/windows": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "niri/window", "custom/closebracket"],
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 20,
    "min-length": 0,
    "all-outputs": true,
  },

  "group/cpuram": {
    "orientation": "horizontal",
    "modules": [
      "custom/openbracket",
      "cpu",
      "custom/split",
      "memory",
      "custom/closebracket",
    ],
  },

  "cpu": {
    "format": "cpu {usage}%",
    "tooltip": false,
    "interval": 2,
    "on-click": "kitty -e btop",
  },

  "memory": {
    "format": "ram {}%",
    "tooltip": false,
    "interval": 2,
    "on-click": "kitty -e btop",
  },

  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "custom/openbracket",
      "clock",
      "custom/split",
      "battery",
      "custom/closebracket",
    ],
  },

  "clock": {
    "format": "time {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "bat: {capacity}% {icon}",
    "format-full": "bat full",
    // "format-icons": ["", "", "", "", ""],
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10,
  },

  "group/tray-box": {
    "orientation": "horizontal",
    "modules": ["custom/openbracket", "tray", "custom/closebracket"],
  },
}
