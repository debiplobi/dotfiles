{
  "layer": "top",
  "position": "top",
  "height": 1,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "memory",
    "cpu",
    "backlight",
    "custom/net_speed",
    "wireplumber",
    "backlight",
    "battery",
    "tray",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "1",
      "2": "2",
      "3": "3",
    },
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true,
  },

  "clock": {
    "timezone": "Asia/Kolkata",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "󰥔 {:%H:%M   %d/%m/%Y}",
    "format-alt": "󰸗 {:%A, %B %d, %Y}",
  },
  "cpu": {
    "format": "  {usage}% ",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}",
    "interval": 2,
    "max-length": 10,
    "on-click": "htop",
  },

  "custom/night": {
    "icon-size": 16,
    "format": "  ",
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "on-click": "gammastep -O 5000 &",
    "on-click-right": "pkill gammastep",
  },
  "memory": {
    "format": "Disk: {}%",
    "interval": 1,
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 80,
    "format": " {temperatureC}°C ",
    "interval": 1,
  },

  "custom/net_speed": {
    "exec": "~/.config/waybar/scripts/net_speed.sh",
    "interval": 2,
    "format": "{text}",
    "tooltip": false,
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱡏",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰦢",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "helvum",
    "tooltip-format": "Volume: {volume}%",
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠", "󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󰛨"],
    "tooltip-format": "Brightness: {percent}%",
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% - {time}",
  },

  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫 ",
      "none": "󰂚 ",
      "dnd-notification": "󱏧 <span foreground='red'><sup></sup></span>",
      "dnd-none": "󱏧 ",
      "inhibited-notification": "󰂚 <span foreground='red'><sup></sup></span>",
      "inhibited-none": "󰂚 ",
      "dnd-inhibited-notification": " <span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "󱏧 ",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "~/.config/swaync/scripts/open-tray.sh",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "passive-items": true,
  },
}
